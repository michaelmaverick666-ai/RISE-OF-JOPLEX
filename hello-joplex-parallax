<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Joplex Parallax Scrolling Design</title>
<style>
:root {
  --bg: #050816;
  --surface: #0d1422;
  --line: #223250;
  --ink: #e7ecf6;
  --muted: #93a0ba;
  --cyan: #00e5ff;
  --green: #39ff88;
  --purple: #b77bff;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  line-height: 1.6;
}

body { overflow-x: hidden; }

/* ---------- Parallax section wrapper ---------- */
.parallax {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 80px 20px;
}

.layer {
  position: absolute;
  inset: -25% 0;
  will-change: transform;
  pointer-events: none;
}

/* Layer 1: star field (slowest, farthest away) */
.stars {
  background-image:
    radial-gradient(2px 2px at 20px 30px, #fff, transparent),
    radial-gradient(1.5px 1.5px at 120px 80px, var(--cyan), transparent),
    radial-gradient(2px 2px at 200px 150px, #fff, transparent),
    radial-gradient(1px 1px at 60px 170px, var(--green), transparent),
    radial-gradient(1.5px 1.5px at 260px 40px, #fff, transparent);
  background-size: 300px 220px;
  opacity: .7;
}

/* Layer 2: perspective grid */
.grid {
  background-image:
    linear-gradient(var(--line) 1px, transparent 1px),
    linear-gradient(90deg, var(--line) 1px, transparent 1px);
  background-size: 56px 56px;
  -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 30%, transparent 100%);
          mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 30%, transparent 100%);
  opacity: .5;
}

/* Layer 3: glowing orbs */
.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(50px);
}
.orb-cyan   { width: 320px; height: 320px; left: 8%;  top: 20%; background: radial-gradient(circle, rgba(0,229,255,.55), transparent 70%); }
.orb-purple { width: 380px; height: 380px; right: 6%; top: 35%; background: radial-gradient(circle, rgba(183,123,255,.45), transparent 70%); }
.orb-green  { width: 260px; height: 260px; left: 45%; bottom: 5%; background: radial-gradient(circle, rgba(57,255,136,.35), transparent 70%); }

/* Layer 4: rings (fastest, closest) */
.ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 420px;
  height: 420px;
  margin: -210px 0 0 -210px;
  border: 1px solid rgba(0,229,255,.35);
  border-radius: 50%;
  box-shadow: inset 0 0 40px rgba(0,229,255,.12);
}
.ring::after {
  content: "";
  position: absolute;
  inset: 40px;
  border: 1px dashed rgba(57,255,136,.3);
  border-radius: 50%;
}

/* ---------- Foreground content ---------- */
.content {
  position: relative;
  z-index: 2;
  max-width: 760px;
}

.eyebrow {
  font-size: .8rem;
  letter-spacing: .3em;
  text-transform: uppercase;
  color: var(--cyan);
  margin: 0 0 14px;
}

h1, h2 {
  font-weight: 800;
  line-height: 1.15;
  margin: 0 0 18px;
}
h1 { font-size: clamp(2.2rem, 7vw, 4.4rem); letter-spacing: .02em; }
h2 { font-size: clamp(1.6rem, 4vw, 2.6rem); }

.lead {
  color: var(--muted);
  font-size: clamp(1rem, 2vw, 1.2rem);
  max-width: 60ch;
  margin: 0 auto 28px;
}

.btn {
  display: inline-block;
  padding: 14px 28px;
  border-radius: 6px;
  border: 1px solid var(--cyan);
  background: var(--cyan);
  color: #031016;
  font-weight: 700;
  text-decoration: none;
  transition: filter .2s ease, transform .2s ease;
}
.btn:hover { filter: brightness(1.1); transform: translateY(-2px); }

/* Scroll cue */
.scroll-cue {
  position: absolute;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  color: var(--muted);
  font-size: .8rem;
  letter-spacing: .2em;
  text-transform: uppercase;
  z-index: 2;
}
.scroll-cue::after {
  content: "";
  display: block;
  width: 1px;
  height: 36px;
  margin: 10px auto 0;
  background: linear-gradient(var(--cyan), transparent);
}

/* ---------- Feature cards ---------- */
.features {
  background: var(--surface);
  display: block;
  text-align: left;
}
.features .content { max-width: 1080px; margin: 0 auto; width: 100%; }
.features h2 { text-align: center; }

.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 20px;
  margin-top: 40px;
}

.card {
  background: var(--bg);
  border: 1px solid var(--line);
  border-top: 3px solid var(--cyan);
  border-radius: 8px;
  padding: 26px;
  opacity: 0;
  transform: translateY(40px);
  transition: opacity .8s ease, transform .8s ease;
}
.card:nth-child(2) { border-top-color: var(--green); }
.card:nth-child(3) { border-top-color: var(--purple); }
.card.visible { opacity: 1; transform: translateY(0); }
.card h3 { margin: 0 0 10px; font-size: 1.1rem; color: var(--ink); }
.card p { margin: 0; color: var(--muted); font-size: .95rem; }

/* ---------- Quote band ---------- */
.quote-band .content { max-width: 900px; }
.quote-band blockquote {
  margin: 0;
  font-size: clamp(1.3rem, 3.5vw, 2.1rem);
  font-weight: 600;
  line-height: 1.4;
}
.quote-band cite {
  display: block;
  margin-top: 18px;
  color: var(--green);
  font-style: normal;
  font-size: .9rem;
  letter-spacing: .15em;
  text-transform: uppercase;
}

/* ---------- Footer CTA ---------- */
.cta { min-height: 70vh; }

/* ---------- Reduced motion ---------- */
@media (prefers-reduced-motion: reduce) {
  .layer, .ring, .orb { transform: none !important; }
  .card { opacity: 1; transform: none; transition: none; }
}

@media (max-width: 600px) {
  .ring { width: 280px; height: 280px; margin: -140px 0 0 -140px; }
}
</style>
</head>
<body>

<!-- ============ HERO ============ -->
<section class="parallax hero" id="hero">
  <div class="layer stars" data-speed="0.1"></div>
  <div class="layer grid" data-speed="0.25"></div>
  <div class="layer" data-speed="0.35">
    <div class="orb orb-cyan"></div>
    <div class="orb orb-purple"></div>
    <div class="orb orb-green"></div>
  </div>
  <div class="layer" data-speed="0.6">
    <div class="ring"></div>
  </div>

  <div class="content" data-speed="-0.08">
    <p class="eyebrow">Rise of Joplex</p>
    <h1>Build the Future, One Scroll at a Time</h1>
    <p class="lead">Layers drift past each other as you scroll, creating depth without a single line of heavy animation code.</p>
    <a class="btn" href="#features">Explore</a>
  </div>

  <div class="scroll-cue">Scroll</div>
</section>

<!-- ============ FEATURES ============ -->
<section class="parallax features" id="features">
  <div class="layer" data-speed="0.15" style="inset:0;">
    <div class="orb orb-green" style="left:-5%;top:10%;"></div>
  </div>

  <div class="content">
    <h2>Built in Layers</h2>
    <div class="card-grid">
      <article class="card reveal">
        <h3>🌌 Depth</h3>
        <p>Background, midground and foreground move at different speeds to create a sense of distance.</p>
      </article>
      <article class="card reveal">
        <h3>⚡ Light and fast</h3>
        <p>Transforms run on the GPU and are throttled with requestAnimationFrame, so scrolling stays smooth.</p>
      </article>
      <article class="card reveal">
        <h3>♿ Accessible</h3>
        <p>Users who prefer reduced motion see a static layout with no movement and no loss of content.</p>
      </article>
    </div>
  </div>
</section>

<!-- ============ QUOTE BAND ============ -->
<section class="parallax quote-band" id="quote">
  <div class="layer grid" data-speed="0.3"></div>
  <div class="layer stars" data-speed="0.12"></div>

  <div class="content" data-speed="-0.15">
    <blockquote>
      "Depth is not decoration. It is how a page tells the reader where to look next."
      <cite>Design principle</cite>
    </blockquote>
  </div>
</section>

<!-- ============ CTA ============ -->
<section class="parallax cta" id="cta">
  <div class="layer" data-speed="0.4">
    <div class="ring" style="width:520px;height:520px;margin:-260px 0 0 -260px;"></div>
  </div>
  <div class="layer orb-layer" data-speed="0.2">
    <div class="orb orb-cyan" style="left:60%;top:30%;"></div>
  </div>

  <div class="content">
    <h2>Ready to Scroll?</h2>
    <p class="lead">Drop this file into any browser, then adjust the <code>data-speed</code> values to tune the depth.</p>
    <a class="btn" href="#hero">Back to the top</a>
  </div>
</section>

<script>
/* Parallax engine: moves each layer by (scroll position x speed).
   Layers with data-speed inside a .parallax section follow that section's position. */
(function () {
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sections = Array.from(document.querySelectorAll(".parallax"));
  let ticking = false;

  function update() {
    ticking = false;
    const vh = window.innerHeight;

    sections.forEach(section => {
      const rect = section.getBoundingClientRect();
      if (rect.bottom < -vh || rect.top > vh * 2) return;

      section.querySelectorAll("[data-speed]").forEach(el => {
        const speed = parseFloat(el.dataset.speed) || 0;
        const offset = -rect.top * speed;
        el.style.transform = "translate3d(0," + offset.toFixed(2) + "px,0)";
      });
    });
  }

  function requestUpdate() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }

  if (!reduceMotion) {
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
    update();
  }

  /* Fade in feature cards as they enter the viewport */
  const cards = document.querySelectorAll(".reveal");
  if ("IntersectionObserver" in window && !reduceMotion) {
    const io = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    cards.forEach(c => io.observe(c));
  } else {
    cards.forEach(c => c.classList.add("visible"));
  }
})();
</script>

</body>
</html>
